# =====================================================================
# AI-Based Meeting Minutes Generator - example environment file
#
# Copy this file to `.env` and edit as needed:
#     cp .env.example .env
#
# Every variable is prefixed with MMA_ (Meeting Minutes AI) so that the
# application never accidentally picks up unrelated system variables.
# All values below are the built-in defaults; you only need to set the
# ones you want to override. No secrets or API keys are required - the
# whole pipeline runs with local, open-source models.
# =====================================================================

# ---------- Application ----------
MMA_APP_NAME="AI-Based Meeting Minutes Generator"
MMA_DEBUG=false
MMA_HOST=0.0.0.0
MMA_PORT=8000

# ---------- Storage ----------
# SQLite database used for meeting history
MMA_DATABASE_URL=sqlite:///meeting_minutes.db
# Maximum accepted upload size, in megabytes
MMA_MAX_UPLOAD_SIZE_MB=500

# ---------- Speech recognition (faster-whisper / CTranslate2) ----------
# Model sizes, smallest to largest: tiny, base, small, medium, large-v3
MMA_WHISPER_MODEL_SIZE=base
# "auto" picks CUDA when available, otherwise falls back to CPU
MMA_WHISPER_DEVICE=auto
# int8 is the fastest option on CPU; use float16 on a CUDA GPU
MMA_WHISPER_COMPUTE_TYPE=int8
# Leave empty for automatic language detection, or force e.g. "en"
MMA_WHISPER_LANGUAGE=

# ---------- Meeting information extraction ----------
# Backends: "transformers" (local HF model) or "rules" (offline fallback)
MMA_EXTRACTION_BACKEND=transformers
# Base model for Phase 3 inference and Phase 4 LoRA fine-tuning
MMA_EXTRACTION_MODEL_NAME=google/flan-t5-base
# Optional path to a LoRA adapter directory produced by training/train.py
# When set, it is used instead of the raw base model.
MMA_EXTRACTION_ADAPTER_PATH=
# Sentence-embedding model used for semantic-similarity evaluation
MMA_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2